  purchases    Purchase[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  materialId      String        @db.Uuid
  orderedQty      Decimal       @db.Decimal(14, 3)
  ratePaisa       BigInt
  sortOrder       Int           @default(0)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  material        Material      @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, purchaseOrderId])
}

/// A supplier delivery (challan). Saved purchases are locked: fixes go through returns / corrections.
model Purchase {
  id                  String               @id @default(uuid(7)) @db.Uuid
  tenantId            String               @db.Uuid
  /// PUR-2026-0001
  number              String
  supplierId          String               @db.Uuid
  deliverTo           DeliverTo
  locationId          String               @db.Uuid
  projectId           String?              @db.Uuid
  purchaseOrderId     String?              @db.Uuid
  /// Supplier challan number, e.g. CH-2231
  challanNo           String
  vehicleNo           String?
  purchaseDate        DateTime             @db.Date
  paymentMode         PurchasePaymentMode
  paidNowPaisa        BigInt               @default(0)
  paidFrom            PaidFrom?
  /// Supplier bill: Σ challan qty × rate (0 while PENDING_RATE)
  totalPaisa          BigInt               @default(0)
  status              PurchaseStatus
  challanAttachmentId String               @db.Uuid
  billAttachmentId    String?              @db.Uuid
  note                String?
  receivedById        String?              @db.Uuid
  receivedAt          DateTime?            @db.Timestamptz(3)
  ratesSetAt          DateTime?            @db.Timestamptz(3)
  createdById         String?              @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier            Supplier             @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  location            StockLocation        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  project             Project?             @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrder       PurchaseOrder?       @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  challan             Attachment           @relation("PurchaseChallan", fields: [tenantId, challanAttachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  bill                Attachment?          @relation("PurchaseBill", fields: [tenantId, billAttachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy           User?                @relation("PurchaseCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy          User?                @relation("PurchaseReceivedBy", fields: [tenantId, receivedById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items               PurchaseItem[]
  returns             PurchaseReturn[]
  corrections         PurchaseCorrection[]
  shortages           Shortage[]
  payments            SupplierPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, supplierId, purchaseDate])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
}

model PurchaseItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  purchaseId  String   @db.Uuid
  materialId  String   @db.Uuid
  challanQty  Decimal  @db.Decimal(14, 3)
  /// null until counted (site deliveries)
  countedQty  Decimal? @db.Decimal(14, 3)
  damagedQty  Decimal  @default(0) @db.Decimal(14, 3)
  /// null while PENDING_RATE
  ratePaisa   BigInt?
  /// Good qty (counted − damaged) × rate
  amountPaisa BigInt   @default(0)
  note        String?
  sortOrder   Int      @default(0)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase    Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Cascade)
  material    Material @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, purchaseId])
}

/// Visible fix of a saved purchase (the original rows stay unchanged).
model PurchaseCorrection {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  purchaseId  String   @db.Uuid
  reason      String
  /// [{ purchaseItemId, materialId, fromQty, toQty, fromRatePaisa, toRatePaisa }]
  items       Json
  /// Change to the supplier bill (signed)
  deltaPaisa  BigInt
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase    Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Cascade)
  createdBy   User?    @relation("PurchaseCorrectionCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, purchaseId])
}

model PurchaseReturn {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @db.Uuid
  /// PRN-0001
  number       String
  purchaseId   String               @db.Uuid
  supplierId   String               @db.Uuid
  locationId   String               @db.Uuid
  reason       String
  totalPaisa   BigInt
  attachmentId String?              @db.Uuid
  note         String?
  createdById  String?              @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase     Purchase             @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  supplier     Supplier             @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  location     StockLocation        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  attachment   Attachment?          @relation("PurchaseReturnAttachment", fields: [tenantId, attachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User?                @relation("PurchaseReturnCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items        PurchaseReturnItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, purchaseId])
}

model PurchaseReturnItem {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  returnId    String         @db.Uuid
  materialId  String         @db.Uuid
  qty         Decimal        @db.Decimal(14, 3)
  ratePaisa   BigInt
  amountPaisa BigInt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  return      PurchaseReturn @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Cascade)
  material    Material       @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, returnId])
}

/// Supplier account (udhaar). Signed: + we owe more (purchase), − we owe less (payment, return).
model SupplierLedgerEntry {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @db.Uuid
  supplierId  String             @db.Uuid
  type        SupplierLedgerType
  amountPaisa BigInt
  /// PURCHASE / PURCHASE_RETURN / PURCHASE_CORRECTION / SUPPLIER_PAYMENT / SHORTAGE
  refType     String?
  refId       String?            @db.Uuid
  projectId   String?            @db.Uuid
  occurredAt  DateTime           @db.Timestamptz(3)
  note        String?
  createdById String?            @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier           @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  project     Project?           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?              @relation("SupplierLedgerCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, supplierId, occurredAt])
}

model SupplierPayment {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @db.Uuid
  supplierId      String                @db.Uuid
  amountPaisa     BigInt
  method          SupplierPaymentMethod
  reference       String?
  chequeNo        String?
  chequeDate      DateTime?             @db.Date
  status          SupplierPaymentStatus
  paidOn          DateTime              @db.Date
  note            String?
  /// Set when paid together with a purchase (CASH / PARTIAL)
  purchaseId      String?               @db.Uuid
  projectId       String?               @db.Uuid
  statusChangedAt DateTime?             @db.Timestamptz(3)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier              @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  purchase        Purchase?             @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  project         Project?              @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?                 @relation("SupplierPaymentCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, supplierId, paidOn])
  @@index([tenantId, status])
}

/// Gate pass: stock moving from one location to another through TRANSIT.
model Dispatch {
  id                    String         @id @default(uuid(7)) @db.Uuid
  tenantId              String         @db.Uuid
  /// GP-0001
  number                String
  fromLocationId        String         @db.Uuid
  toLocationId          String         @db.Uuid
  vehicleNo             String?
  driverName            String?
  driverPhone           String?
  dispatchedAt          DateTime       @db.Timestamptz(3)
  loadPhotoAttachmentId String?        @db.Uuid
  note                  String?
  status                DispatchStatus @default(ON_THE_WAY)
  receivedById          String?        @db.Uuid
  receivedAt            DateTime?      @db.Timestamptz(3)
  receiveNote           String?
  cancelledAt           DateTime?      @db.Timestamptz(3)
  createdById           String?        @db.Uuid
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromLocation          StockLocation  @relation("DispatchFrom", fields: [tenantId, fromLocationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  toLocation            StockLocation  @relation("DispatchTo", fields: [tenantId, toLocationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  loadPhoto             Attachment?    @relation("DispatchLoadPhoto", fields: [tenantId, loadPhotoAttachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy             User?          @relation("DispatchCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy            User?          @relation("DispatchReceivedBy", fields: [tenantId, receivedById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items                 DispatchItem[]
  shortages             Shortage[]     @relation("ShortageDispatch")
  replacementFor        Shortage[]     @relation("ShortageNewDispatch")

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, toLocationId, status])
  @@index([tenantId, fromLocationId, status])
}

model DispatchItem {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @db.Uuid
  dispatchId        String      @db.Uuid
  materialId        String      @db.Uuid
  sentQty           Decimal     @db.Decimal(14, 3)
  /// Average cost at the source when dispatched
  unitCostPaisa     BigInt
  receivedQty       Decimal?    @db.Decimal(14, 3)
  damagedQty        Decimal?    @db.Decimal(14, 3)
  note              String?
  photoAttachmentId String?     @db.Uuid
  sortOrder         Int         @default(0)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch          Dispatch    @relation(fields: [tenantId, dispatchId], references: [tenantId, id], onDelete: Cascade)
  material          Material    @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  photo             Attachment? @relation("DispatchItemPhoto", fields: [tenantId, photoAttachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, dispatchId])
}

/// A difference found when counting a delivery; stays OPEN until the owner decides.
model Shortage {
  id                   String              @id @default(uuid(7)) @db.Uuid
  tenantId             String              @db.Uuid
  kind                 ShortageKind
  source               ShortageSource
  dispatchId           String?             @db.Uuid
  purchaseId           String?             @db.Uuid
  projectId            String?             @db.Uuid
  /// Where it was counted
  locationId           String              @db.Uuid
  materialId           String              @db.Uuid
  qty                  Decimal             @db.Decimal(14, 3)
  valuePaisa           BigInt
  status               ShortageStatus      @default(OPEN)
  /// Receiver note when counting
  note                 String?
  resolution           ShortageResolution?
  resolutionNote       String?
  recoveredAmountPaisa BigInt?
  newDispatchId        String?             @db.Uuid
  resolvedById         String?             @db.Uuid
  resolvedAt           DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch             Dispatch?           @relation("ShortageDispatch", fields: [tenantId, dispatchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  purchase             Purchase?           @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  project              Project?            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  location             StockLocation       @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  material             Material            @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  newDispatch          Dispatch?           @relation("ShortageNewDispatch", fields: [tenantId, newDispatchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy           User?               @relation("ShortageResolvedBy", fields: [tenantId, resolvedById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, projectId])
}

/// Material the owner (client) delivered to the site himself, tracked at cost 0.
model OwnerDelivery {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @db.Uuid
  projectId          String              @db.Uuid
  locationId         String              @db.Uuid
  deliveryDate       DateTime            @db.Date
  note               String?
  photoAttachmentIds String[]            @default([]) @db.Uuid
  createdById        String?             @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy          User?               @relation("OwnerDeliveryCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items              OwnerDeliveryItem[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId, deliveryDate])
}

model OwnerDeliveryItem {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @db.Uuid
  deliveryId String        @db.Uuid
  materialId String        @db.Uuid
  qty        Decimal       @db.Decimal(14, 3)
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delivery   OwnerDelivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id], onDelete: Cascade)
  material   Material      @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, deliveryId])
}

model MaterialUsage {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @db.Uuid
  projectId       String              @db.Uuid
  locationId      String              @db.Uuid
  usageDate       DateTime            @db.Date
  note            String?
  /// Schedule milestone (later phase)
  milestoneId     String?             @db.Uuid
  /// When the entry was made on the phone (offline sync)
  deviceCreatedAt DateTime?           @db.Timestamptz(3)
  createdById     String?             @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?               @relation("MaterialUsageCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items           MaterialUsageItem[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId, usageDate])
}

model MaterialUsageItem {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @db.Uuid
  usageId       String        @db.Uuid
  materialId    String        @db.Uuid
  qty           Decimal       @db.Decimal(14, 3)
  ownerSupplied Boolean       @default(false)
  /// At average cost (0 for owner-supplied)
  valuePaisa    BigInt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usage         MaterialUsage @relation(fields: [tenantId, usageId], references: [tenantId, id], onDelete: Cascade)
  material      Material      @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, usageId])
}

model StockCount {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @db.Uuid
  /// SC-0001
  number      String
  locationId  String           @db.Uuid
  countedAt   DateTime         @db.Timestamptz(3)
  note        String?
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    StockLocation    @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?            @relation("StockCountCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items       StockCountItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, locationId, countedAt])
}

model StockCountItem {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @db.Uuid
  countId       String            @db.Uuid
  materialId    String            @db.Uuid
  ownerSupplied Boolean           @default(false)
  systemQty     Decimal           @db.Decimal(14, 3)
  countedQty    Decimal           @db.Decimal(14, 3)
  difference    Decimal           @db.Decimal(14, 3)
  reason        StockCountReason?
  note          String?
  valuePaisa    BigInt            @default(0)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  count         StockCount        @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Cascade)
  material      Material          @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, countId])
}

// ─── Labour & cash book (Phase 1 · Step 7) ──────────────────────────────────

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  FULL
  HALF
  ABSENT
}

enum SubcontractRateType {
  PER_SQFT
  PER_TON
  PER_BRICK
  PER_RFT
  PER_CFT
  LUMPSUM
}

enum MeasurementStatus {
  RECORDED
  VERIFIED
  REJECTED
}

enum PayeeType {
  WORKER
  SUBCONTRACTOR
}

enum LaborPaidFrom {
  SITE_CASH
  OFFICE_CASH
  BANK
  JAZZCASH
  EASYPAISA
}

enum SettlementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum LinePaymentStatus {
  UNPAID
  PAID
}

enum SubcontractEntryType {
  WORK_VALUE
  ADVANCE
  RUNNING_PAYMENT
  DEDUCTION
  RETENTION_RELEASE
  ADJUSTMENT
}

enum CashEntryType {
  FLOAT_IN
  EXPENSE
  PESHGI
  WAGE_PAYMENT
  SUBCONTRACT_PAYMENT
  PURCHASE
  HANDOVER_OUT
  HANDOVER_IN
  COUNT_ADJUSTMENT
  REFUND_IN
}

enum ExpenseCategory {
  TEA_WATER
  TRANSPORT
  UNLOADING
  FUEL
  SMALL_TOOLS
  URGENT_MATERIAL
  OWNER_PURCHASE
  REPAIRS
  OTHER
}

enum CostBucket {
  OVERHEAD
  LABOR
  MATERIAL
  EQUIPMENT
  RECOVERABLE_FROM_OWNER
}

enum CashEntryStatus {
  /// Float sent, not yet acknowledged by the holder (not in the balance).
  PENDING_ACK
  /// Kharcha above the approval limit (in the balance — the cash is already spent).
  PENDING_APPROVAL
  APPROVED
  /// Kharcha refused: still in the balance, owed back by the holder.
  REJECTED
  POSTED
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FloatMethod {
  CASH
  BANK
  JAZZCASH
  EASYPAISA
}

/// A daily-wage worker on a project, with the project's rate for them.
model ProjectWorker {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  projectId      String    @db.Uuid
  workerId       String    @db.Uuid
  dailyRatePaisa BigInt
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  worker         Worker    @relation(fields: [tenantId, workerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([projectId, workerId])
  @@index([tenantId, projectId])
}

/// A sub-contractor's piece-rate (or lump-sum) work on a project.
model SubcontractAssignment {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  tenantId           String                   @db.Uuid
  projectId          String                   @db.Uuid
  subcontractorId    String                   @db.Uuid
  scope              String
  rateType           SubcontractRateType
  /// Unit rate (not LUMPSUM)
  ratePaisa          BigInt?
  /// LUMPSUM only
  contractValuePaisa BigInt?
  retentionPercent   Decimal                  @default(5) @db.Decimal(5, 2)
  /// LUMPSUM: cumulative progress posted so far
  progressPercent    Decimal                  @default(0) @db.Decimal(5, 2)
  startDate          DateTime                 @db.Date
  isActive           Boolean                  @default(true)
  createdById        String?                  @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project            Project                  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  subcontractor      Subcontractor            @relation(fields: [tenantId, subcontractorId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  measurements       WorkMeasurement[]
  advances           Advance[]
  ledger             SubcontractLedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
}

/// Hazri: one row per worker per day on a project.
model Attendance {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  projectId       String           @db.Uuid
  workerId        String           @db.Uuid
  date            DateTime         @db.Date
  status          AttendanceStatus
  overtimeHours   Decimal          @default(0) @db.Decimal(4, 2)
  note            String?
  markedById      String?          @db.Uuid
  clientId        String?          @db.Uuid
  deviceCreatedAt DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  worker          Worker           @relation(fields: [tenantId, workerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([projectId, workerId, date])
  @@index([tenantId, projectId, date])
}

model WorkMeasurement {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @db.Uuid
  projectId       String                @db.Uuid
  assignmentId    String                @db.Uuid
  date            DateTime              @db.Date
  description     String
  quantity        Decimal               @db.Decimal(14, 3)
  unit            String
  attachmentIds   String[]              @default([]) @db.Uuid
  status          MeasurementStatus     @default(RECORDED)
  verifiedById    String?               @db.Uuid
  verifiedAt      DateTime?             @db.Timestamptz(3)
  note            String?
  clientId        String?               @db.Uuid
  deviceCreatedAt DateTime?             @db.Timestamptz(3)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignment      SubcontractAssignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, clientId])
  @@index([tenantId, projectId, date])
}

/// Peshgi: money given ahead of wages / sub-contract payments.
model Advance {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String                 @db.Uuid
  projectId       String                 @db.Uuid
  payeeType       PayeeType
  workerId        String?                @db.Uuid
  assignmentId    String?                @db.Uuid
  amountPaisa     BigInt
  date            DateTime               @db.Date
  paidFrom        LaborPaidFrom
  cashAccountId   String?                @db.Uuid
  reference       String?
  note            String?
  clientId        String?                @db.Uuid
  deviceCreatedAt DateTime?              @db.Timestamptz(3)
  createdById     String?                @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project                @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  worker          Worker?                @relation(fields: [tenantId, workerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignment      SubcontractAssignment? @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  allocations     SettlementAdvance[]

  @@unique([tenantId, id])
  @@unique([tenantId, clientId])
  @@index([tenantId, projectId, date])
}

model WageSettlement {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @db.Uuid
  projectId     String               @db.Uuid
  weekStart     DateTime             @db.Date
  weekEnd       DateTime             @db.Date
  status        SettlementStatus     @default(DRAFT)
  grossPaisa    BigInt               @default(0)
  advancePaisa  BigInt               @default(0)
  netPaisa      BigInt               @default(0)
  paidPaisa     BigInt               @default(0)
  submittedById String?              @db.Uuid
  submittedAt   DateTime?            @db.Timestamptz(3)
  approvedById  String?              @db.Uuid
  approvedAt    DateTime?            @db.Timestamptz(3)
  returnComment String?
  createdById   String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project              @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  lines         WageSettlementLine[]

  @@unique([tenantId, id])
  @@unique([projectId, weekStart])
  @@index([tenantId, status])
}

model WageSettlementLine {
  id                   String              @id @default(uuid(7)) @db.Uuid
  tenantId             String              @db.Uuid
  settlementId         String              @db.Uuid
  workerId             String              @db.Uuid
  fullDays             Int
  halfDays             Int
  daysWorked           Decimal             @db.Decimal(5, 1)
  dailyRatePaisa       BigInt
  overtimeHours        Decimal             @db.Decimal(6, 2)
  overtimePaisa        BigInt
  grossPaisa           BigInt
  advanceAdjustedPaisa BigInt
  /// The advance adjustment was set by hand (kept on regenerate).
  advanceOverride      Boolean             @default(false)
  overrideNote         String?
  netPaisa             BigInt
  paymentStatus        LinePaymentStatus   @default(UNPAID)
  paidFrom             LaborPaidFrom?
  paidAt               DateTime?           @db.Timestamptz(3)
  paidById             String?             @db.Uuid
  cashEntryId          String?             @db.Uuid
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlement           WageSettlement      @relation(fields: [tenantId, settlementId], references: [tenantId, id], onDelete: Cascade)
  worker               Worker              @relation(fields: [tenantId, workerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  advances             SettlementAdvance[]

  @@unique([tenantId, id])
  @@unique([settlementId, workerId])
}

/// Which advances a settlement line adjusts (oldest first).
model SettlementAdvance {
  tenantId    String             @db.Uuid
  lineId      String             @db.Uuid
  advanceId   String             @db.Uuid
  amountPaisa BigInt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line        WageSettlementLine @relation(fields: [tenantId, lineId], references: [tenantId, id], onDelete: Cascade)
  advance     Advance            @relation(fields: [tenantId, advanceId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([lineId, advanceId])
  @@index([tenantId, advanceId])
}

/// Sub-contractor running account. Signed: + owed to them, − paid / deducted. Append-only.
model SubcontractLedgerEntry {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @db.Uuid
  assignmentId String                @db.Uuid
  type         SubcontractEntryType
  amountPaisa  BigInt
  refType      String?
  refId        String?               @db.Uuid
  occurredAt   DateTime              @db.Timestamptz(3)
  note         String?
  createdById  String?               @db.Uuid
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment   SubcontractAssignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, assignmentId, occurredAt])
}

/// Cash held by a munshi / PM. Balance = Σ entries except PENDING_ACK floats.
model CashAccount {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  holderUserId String         @db.Uuid
  name         String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holder       User           @relation("CashAccountHolder", fields: [tenantId, holderUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  entries      CashEntry[]
  topups       TopupRequest[]
  counts       CashCount[]

  @@unique([tenantId, id])
  @@index([tenantId, holderUserId])
}

model CashEntry {
  id                    String           @id @default(uuid(7)) @db.Uuid
  tenantId              String           @db.Uuid
  accountId             String           @db.Uuid
  projectId             String?          @db.Uuid
  type                  CashEntryType
  /// Signed: + into the holder's cash, − out of it
  amountPaisa           BigInt
  category              ExpenseCategory?
  costBucket            CostBucket?
  description           String
  attachmentId          String?          @db.Uuid
  status                CashEntryStatus
  method                FloatMethod?
  reference             String?
  approvedById          String?          @db.Uuid
  approvedAt            DateTime?        @db.Timestamptz(3)
  reviewNote            String?
  /// Rejected kharcha the holder must pay back
  recoverableFromHolder Boolean          @default(false)
  refType               String?
  refId                 String?          @db.Uuid
  clientId              String?          @db.Uuid
  deviceCreatedAt       DateTime?        @db.Timestamptz(3)
  occurredAt            DateTime         @db.Timestamptz(3)
  createdById           String?          @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account               CashAccount      @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  project               Project?         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, clientId])
  @@index([tenantId, accountId, occurredAt])
  @@index([tenantId, projectId, occurredAt])
  @@index([tenantId, status])
}

model TopupRequest {
  id           String      @id @default(uuid(7)) @db.Uuid
  tenantId     String      @db.Uuid
  accountId    String      @db.Uuid
  amountPaisa  BigInt
  note         String?
  status       TopupStatus @default(PENDING)
  decidedById  String?     @db.Uuid
  decidedAt    DateTime?   @db.Timestamptz(3)
  decisionNote String?
  floatEntryId String?     @db.Uuid
  clientId     String?     @db.Uuid
  createdById  String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      CashAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, clientId])
  @@index([tenantId, status])
}

model CashCount {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @db.Uuid
  accountId         String      @db.Uuid
  systemPaisa       BigInt
  countedPaisa      BigInt
  differencePaisa   BigInt
  note              String?
  adjustmentEntryId String?     @db.Uuid
  countedById       String?     @db.Uuid
  countedAt         DateTime    @db.Timestamptz(3)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           CashAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, accountId, countedAt])
}
