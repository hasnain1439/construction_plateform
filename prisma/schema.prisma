// Core multi-tenant schema for the Construction Management SaaS.
//
// Conventions
// - IDs are UUID v7 (time-ordered) stored as native `uuid`.
// - Money is BigInt paisa (1 PKR = 100 paisa). Never use floats for money.
// - Timestamps are stored in UTC (`timestamptz`).
// - Every tenant-scoped table carries `tenantId` and is protected by
//   PostgreSQL row-level security (see prisma/rls.sql). Child rows reference
//   tenant-scoped parents through composite `(tenantId, id)` keys so a row can
//   never point at another tenant's data.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  READ_ONLY
  SUSPENDED
  CLOSED
}

enum Region {
  PUNJAB_KP
  KARACHI_SINDH
}

enum UserRole {
  THEKEDAR
  PM
  MUNSHI
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AttachmentKind {
  LOGO
  PROFILE_PHOTO
  SITE_PHOTO
  RECEIPT
  DOCUMENT
  VOICE_NOTE
  PAYMENT_SLIP
}

enum HolidayType {
  NON_WORKING
  PARTIAL
}

enum Language {
  ENGLISH
  ROMAN_URDU
  URDU
}

/// TRIAL / ACTIVE / GRACE keep the company ACTIVE; LAPSED makes it READ_ONLY.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  /// Period ended; 3 days to pay before LAPSED.
  GRACE
  LAPSED
  CANCELLED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  RAAST
  IBFT
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

enum ActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  /// Over the plan's active-project limit after a downgrade: viewable, not editable.
  READ_ONLY
}

// ─── Platform (not tenant-scoped) ───────────────────────────────────────────

model PlatformAdmin {
  id               String                 @id @default(uuid(7)) @db.Uuid
  email            String                 @unique
  name             String
  passwordHash     String
  isActive         Boolean                @default(true)
  failedLoginCount Int                    @default(0)
  lockedUntil      DateTime?              @db.Timestamptz(3)
  lastLoginAt      DateTime?              @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  sessions         PlatformAdminSession[]
  reviewedPayments SubscriptionPayment[]
}

model PlatformAdminSession {
  id           String        @id @default(uuid(7)) @db.Uuid
  adminId      String        @db.Uuid
  tokenHash    String        @unique
  familyId     String        @db.Uuid
  expiresAt    DateTime      @db.Timestamptz(3)
  revokedAt    DateTime?     @db.Timestamptz(3)
  replacedById String?       @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([adminId])
}

model Plan {
  id                String                @id @default(uuid(7)) @db.Uuid
  code              String                @unique
  name              String
  priceMonthlyPaisa BigInt                @default(0)
  /// null = unlimited
  maxActiveProjects Int?
  /// Office users = THEKEDAR + PM (+ pending PM invites). Munshis are not counted. null = unlimited.
  maxOfficeUsers    Int?
  /// Marketing bullet points shown on the plans screen.
  features          String[]              @default([])
  /// Display order on the plans screen (ascending).
  sortOrder         Int                   @default(0)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  subscriptions     Subscription[]        @relation("SubscriptionPlan")
  pendingFor        Subscription[]        @relation("SubscriptionPendingPlan")
  payments          SubscriptionPayment[]
}

/// Nationwide (region null) or regional public holidays, managed by platform admins.
model PlatformHoliday {
  id        String      @id @default(uuid(7)) @db.Uuid
  startDate DateTime    @db.Date
  /// null = single day
  endDate   DateTime?   @db.Date
  name      String
  type      HolidayType @default(NON_WORKING)
  region    Region?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([startDate, name])
}

/// Last run of each background job (shown on GET /admin/health).
model JobRun {
  name           String    @id
  lastStartedAt  DateTime  @db.Timestamptz(3)
  lastFinishedAt DateTime? @db.Timestamptz(3)
  /// RUNNING / SUCCESS / FAILED
  lastStatus     String
  lastError      String?
  lastResult     Json?
}

/// Accessed only through the admin (BYPASSRLS) client during auth flows.
model OtpCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime   @db.Timestamptz(3)
  attempts   Int        @default(0)
  consumedAt DateTime?  @db.Timestamptz(3)
  lastSentAt DateTime   @db.Timestamptz(3)
  /// Set once the OTP has been used to sign in to a specific company.
  tenantId   String?    @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  /// Hourly send limit counts all purposes for a phone.
  @@index([phone, createdAt])
}

// ─── Tenant core ────────────────────────────────────────────────────────────

model Tenant {
  id                   String                @id @default(uuid(7)) @db.Uuid
  name                 String
  slug                 String                @unique
  status               TenantStatus          @default(ACTIVE)
  region               Region
  /// National Tax Number, e.g. 1234567-8
  ntn                  String?
  address              String?
  /// E.164 office phone
  phone                String?
  email                String?
  logoAttachmentId     String?               @db.Uuid
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  /// Same-tenant + kind LOGO is enforced by the company service (RLS lookup). A composite
  /// (id, logoAttachmentId) FK would stop Prisma generating Tenant.id defaults.
  logo                 Attachment?           @relation("TenantLogo", fields: [logoAttachmentId], references: [id], onDelete: SetNull)
  settings             TenantSettings?
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  users                User[]
  projects             Project[]
  userProjectAccess    UserProjectAccess[]
  invitations          Invitation[]
  devices              Device[]
  sessions             Session[]
  companyHolidays      CompanyHoliday[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
}

model TenantSettings {
  tenantId                  String   @id @db.Uuid
  /// Square feet per marla: 225 (societies) or 272.25 (revenue marla).
  marlaStandardSqft         Decimal  @default(225) @db.Decimal(6, 2)
  currency                  String   @default("PKR")
  timezone                  String   @default("Asia/Karachi")
  defaultLanguage           Language @default(ROMAN_URDU)
  weekStartsOn              Int      @default(1)
  /// Kharcha (site expense) above this needs THEKEDAR approval. Paisa. Default Rs 25,000.
  kharchaApprovalLimitPaisa BigInt   @default(2500000)
  /// Alert when material use exceeds the estimate by this percent (1–20).
  overuseAlertPercent       Int      @default(10)
  /// Local time (HH:MM, tenant timezone) after which a missing daily site log raises an alert.
  missingLogAlertTime       String   @default("18:00")
  quoteValidityDays         Int      @default(15)
  taxEnabled                Boolean  @default(false)
  /// Default for `canSeeFinancials` on new PM invitations.
  pmCanSeeFinancials        Boolean  @default(false)
  createdAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String                @id @default(uuid(7)) @db.Uuid
  tenantId             String                @unique @db.Uuid
  planId               String                @db.Uuid
  status               SubscriptionStatus
  trialEndsAt          DateTime?             @db.Timestamptz(3)
  currentPeriodStart   DateTime?             @db.Timestamptz(3)
  currentPeriodEnd     DateTime?             @db.Timestamptz(3)
  /// currentPeriodEnd + 3 days while in GRACE.
  graceEndsAt          DateTime?             @db.Timestamptz(3)
  /// Requested plan change. Upgrades apply when their payment is approved (pendingEffectiveOn null);
  /// downgrades apply at pendingEffectiveOn (= currentPeriodEnd).
  pendingPlanId        String?               @db.Uuid
  pendingEffectiveOn   DateTime?             @db.Timestamptz(3)
  /// Projects that stay ACTIVE when a downgrade lowers the active-project limit.
  keepActiveProjectIds String[]              @default([]) @db.Uuid
  lastReminderSentAt   DateTime?             @db.Timestamptz(3)
  cancelledAt          DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan                  @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan          Plan?                 @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  payments             SubscriptionPayment[]

  @@unique([tenantId, id])
  @@index([status])
}

/// Manual payment (JazzCash / Easypaisa / Raast / bank transfer) with an uploaded slip,
/// reviewed by a platform admin (Phase 1 · Step 3B).
model SubscriptionPayment {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @db.Uuid
  subscriptionId String         @db.Uuid
  planId         String         @db.Uuid
  amountPaisa    BigInt
  method         PaymentMethod
  /// Upper-cased; unique across ALL tenants (a slip can only be used once).
  transactionId  String         @unique
  paidOn         DateTime       @db.Date
  status         PaymentStatus  @default(PENDING_REVIEW)
  rejectReason   String?
  /// Slip image/PDF (kind PAYMENT_SLIP). Null only for historical/admin-entered payments.
  attachmentId   String?        @db.Uuid
  submittedById  String?        @db.Uuid
  /// Set when approved.
  periodStart    DateTime?      @db.Timestamptz(3)
  periodEnd      DateTime?      @db.Timestamptz(3)
  receiptNo      String?        @unique
  reviewedAt     DateTime?      @db.Timestamptz(3)
  /// Platform admin who approved / rejected it.
  reviewedById   String?        @db.Uuid
  reviewNote     String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription   @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)
  plan           Plan           @relation(fields: [planId], references: [id])
  slip           Attachment?    @relation("PaymentSlip", fields: [tenantId, attachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  submittedBy    User?          @relation("PaymentSubmittedBy", fields: [tenantId, submittedById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy     PlatformAdmin? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status])
}

model User {
  id                String                @id @default(uuid(7)) @db.Uuid
  tenantId          String                @db.Uuid
  name              String
  /// E.164, e.g. +923001234567
  phone             String
  email             String?
  /// null for OTP-only users (typically MUNSHI)
  passwordHash      String?
  role              UserRole
  status            UserStatus            @default(ACTIVE)
  language          Language              @default(ROMAN_URDU)
  photoAttachmentId String?               @db.Uuid
  canSeeFinancials  Boolean               @default(false)
  failedLoginCount  Int                   @default(0)
  lockedUntil       DateTime?             @db.Timestamptz(3)
  passwordChangedAt DateTime?             @db.Timestamptz(3)
  lastLoginAt       DateTime?             @db.Timestamptz(3)
  deactivatedAt     DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photo             Attachment?           @relation("UserPhoto", fields: [tenantId, photoAttachmentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  projectAccess     UserProjectAccess[]
  devices           Device[]
  sessions          Session[]
  acceptedInvites   Invitation[]          @relation("InvitationAcceptedUser")
  sentInvites       Invitation[]          @relation("InvitationInvitedBy")
  uploads           Attachment[]          @relation("AttachmentUploadedBy")
  submittedPayments SubscriptionPayment[] @relation("PaymentSubmittedBy")

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([phone])
  @@index([email])
}

/// Stub — the Projects module will extend this.
model Project {
  id         String              @id @default(uuid(7)) @db.Uuid
  tenantId   String              @db.Uuid
  name       String
  status     ProjectStatus       @default(ACTIVE)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccess UserProjectAccess[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model UserProjectAccess {
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  project   Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([tenantId, projectId])
}

model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @db.Uuid
  /// sha256(token + pepper); the raw token only exists in the invite link.
  tokenHash        String           @unique
  role             UserRole
  name             String
  phone            String
  email            String?
  canSeeFinancials Boolean          @default(false)
  projectIds       String[]         @db.Uuid
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @db.Timestamptz(3)
  invitedById      String?          @db.Uuid
  acceptedUserId   String?          @db.Uuid
  acceptedAt       DateTime?        @db.Timestamptz(3)
  /// Last time a new link was sent (resend is limited to once per 60 s).
  lastResentAt     DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy        User?            @relation("InvitationInvitedBy", fields: [tenantId, invitedById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  acceptedUser     User?            @relation("InvitationAcceptedUser", fields: [tenantId, acceptedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, status])
  @@index([tenantId, phone, status])
}

model Device {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @db.Uuid
  userId         String         @db.Uuid
  /// Stable id generated by the client app/browser.
  clientDeviceId String
  platform       DevicePlatform
  model          String?
  appVersion     String?
  lastActiveAt   DateTime       @default(now()) @db.Timestamptz(3)
  /// Last successful offline-sync from the mobile app (set by the sync module).
  lastSyncAt     DateTime?      @db.Timestamptz(3)
  /// Items queued on the device at last sync.
  pendingUploads Int            @default(0)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  sessions       Session[]

  @@unique([tenantId, id])
  @@unique([userId, clientDeviceId])
  @@index([tenantId])
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  deviceId     String    @db.Uuid
  /// sha256(refreshToken + pepper)
  tokenHash    String    @unique
  /// All sessions produced by rotating one login share a family.
  familyId     String    @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(3)
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  device       Device    @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([deviceId])
}

model CompanyHoliday {
  id        String      @id @default(uuid(7)) @db.Uuid
  tenantId  String      @db.Uuid
  startDate DateTime    @db.Date
  /// null = single day
  endDate   DateTime?   @db.Date
  name      String
  type      HolidayType @default(NON_WORKING)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, startDate, name])
}

model Attachment {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @db.Uuid
  kind         AttachmentKind
  /// tenantId/yyyy/mm/<id>.<ext> inside the storage provider
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?               @db.Uuid
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User?                 @relation("AttachmentUploadedBy", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  userPhotos   User[]                @relation("UserPhoto")
  tenantLogos  Tenant[]              @relation("TenantLogo")
  paymentSlips SubscriptionPayment[] @relation("PaymentSlip")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// null for platform-level events (e.g. admin.login)
  tenantId   String?   @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}
