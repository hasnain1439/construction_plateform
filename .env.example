NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# App connections (see README "Database roles")
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/construction
DATABASE_ADMIN_URL=postgresql://app_admin:CHANGE_ME@localhost:5432/construction
# Prisma CLI only (migrations, seed): schema owner / superuser
DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME@localhost:5432/construction
# Connections per pool (app_user, app_admin) and how long a request waits for one (ms) before 503 SERVICE_BUSY
# DB_POOL_MAX=20
# DB_TX_MAX_WAIT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-chars
JWT_REFRESH_PEPPER=change-me-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=.example.com
# ENABLE_DOCS=true
# TRUST_PROXY=1
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT_MAX=10
# AUTH_IP_RATE_LIMIT_MAX=30
# OTP_SEND_IP_RATE_LIMIT_MAX=20
# SYNC_PUSH_RATE_LIMIT_MAX=60
# GENERAL_RATE_LIMIT_MAX=300
# OTP_TTL_SECONDS=300   # max 600 (10 minutes)
# LOG_LEVEL=info        # fatal | error | warn | info | debug | trace | silent
# Mobile app: older builds see a "please update" screen
# MOBILE_MIN_APP_VERSION=1.0.0
# MOBILE_LATEST_APP_VERSION=1.0.0
REDIS_URL=redis://localhost:6379

# ─── Production providers ────────────────────────────────────────────────────
# With NODE_ENV=production the API refuses to start with SMS_PROVIDER=console, MAIL_PROVIDER=console
# or STORAGE_PROVIDER=local. A staging server may opt out explicitly:
# ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true

# ─── SMS ─────────────────────────────────────────────────────────────────────
# console = print to the terminal (dev/tests) | http = any HTTP SMS gateway (see README → Providers)
SMS_PROVIDER=console
# Sender ID / mask approved by the gateway ({sender})
# SMS_SENDER_ID=MUNSHI
# Endpoint; may contain {to} {message} {sender} {type} {templateId} (URL-encoded)
# SMS_HTTP_URL=https://sms-gateway.example.pk/api/send
# SMS_HTTP_METHOD=POST              # GET | POST
# SMS_HTTP_CONTENT_TYPE=json        # json | form (POST body format)
# POST body (or extra GET query) with the same placeholders. Defaults:
#   json: {"to":"{to}","message":"{message}","sender":"{sender}"}   form: to={to}&message={message}&sender={sender}
# SMS_HTTP_BODY_TEMPLATE='{"to":"{to}","message":"{message}","sender":"{sender}"}'
# SMS_HTTP_AUTH=none                # none | bearer | basic | header | query
# SMS_HTTP_API_KEY=CHANGE_ME        # bearer / header / query
# SMS_HTTP_AUTH_HEADER=X-API-Key    # header name for SMS_HTTP_AUTH=header
# SMS_HTTP_AUTH_QUERY_PARAM=api_key # query parameter for SMS_HTTP_AUTH=query
# SMS_HTTP_USERNAME=                # basic
# SMS_HTTP_PASSWORD=                # basic
# SMS_HTTP_PHONE_FORMAT=international  # e164 (+923001234567) | international (923001234567) | local (03001234567)
# Success = HTTP 2xx, AND the body matches SUCCESS_MATCH (if set), AND does not match FAILURE_MATCH (if set). Regexes, case-insensitive.
# SMS_HTTP_SUCCESS_MATCH='"status":\s*"(ok|success)"'
# SMS_HTTP_FAILURE_MATCH=error|invalid|insufficient
# Dot path of the message id in a JSON answer (stored in the delivery log)
# SMS_HTTP_ID_PATH=data.messageId
# SMS_HTTP_TIMEOUT_MS=10000
# Per-message-type text (JSON). Types: OTP, PASSWORD_RESET, INVITE, NOTIFICATION, SUBSCRIPTION_REMINDER,
# CASHBOOK, DISPATCH, PLATFORM. Placeholders: OTP/PASSWORD_RESET {code} {minutes}; INVITE {name} {company} {role} {url};
# every type {message} (the built-in text). Unset types keep the built-in text.
# SMS_TEMPLATES='{"OTP":"Munshi App code: {code}. {minutes} min mein expire ho jayega. Kisi ko na batayen."}'
# Gateway template ids per type (JSON) → {templateId}
# SMS_TEMPLATE_IDS='{"OTP":"1001","INVITE":"1002"}'

# ─── Email ───────────────────────────────────────────────────────────────────
# console = print to the terminal | smtp = SMTP_* | ses = Amazon SES API (recommended for production)
MAIL_PROVIDER=console
# Sender on a domain with SPF / DKIM / DMARC set up (required for ses; defaults to SMTP_USER for smtp)
# MAIL_FROM=Construction Platform <no-reply@mail.example.pk>
# Gmail: smtp.gmail.com, port 587, your address + a 16-character App Password (Google account → Security → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false   # true for port 465; defaults from the port
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# Amazon SES (MAIL_PROVIDER=ses)
# SES_REGION=eu-west-1
# Leave both unset to use the standard AWS credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, profile, IAM role)
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=transactional

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Off by default. On: invites and login codes ALSO go by WhatsApp (SMS + share links stay).
WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_ACCESS_TOKEN=CHANGE_ME     # permanent System User token with whatsapp_business_messaging
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved template names per message type (see README → WhatsApp for the variables)
# WHATSAPP_TEMPLATE_INVOICE=invoice_issued
# WHATSAPP_TEMPLATE_STATEMENT=account_statement
# WHATSAPP_TEMPLATE_INVITE=team_invite
# WHATSAPP_TEMPLATE_OTP=login_code

# ─── File storage ────────────────────────────────────────────────────────────
# local (default: files in STORAGE_DIR) | cloudinary | s3 (AWS S3 / Cloudflare R2 / MinIO, private bucket)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
# Signed download links expire after this many seconds (default 600 = 10 min)
# SIGNED_URL_TTL_SECONDS=600
# WhatsApp share links (/api/v1/public/files/:id) stay valid this many days (1–90)
# SHARE_LINK_TTL_DAYS=30
# PDFs rendered at once per API process; the rest wait up to PDF_QUEUE_WAIT_MS, then 503 SERVICE_BUSY
# PDF_MAX_CONCURRENT=3
# PDF_QUEUE_WAIT_MS=30000
# Required when STORAGE_PROVIDER=cloudinary:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=CHANGE_ME
# Optional — Cloudinary token-based auth key, makes thumbnail URLs expire too:
# CLOUDINARY_AUTH_TOKEN_KEY=
# Required when STORAGE_PROVIDER=s3 (also used by `npm run storage:migrate`):
# S3_BUCKET=munshi-files
# S3_REGION=me-central-1            # "auto" for Cloudflare R2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # only for R2 / MinIO / other S3-compatible
# Leave both unset to use the standard AWS credentials (env, profile, IAM role)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false         # true for MinIO
# S3_SERVER_SIDE_ENCRYPTION=AES256  # AES256 | none (only if the service rejects the header)
# API_PUBLIC_URL=http://localhost:4000

# ─── Observability (all optional — empty = off) ─────────────────────────────
# Sentry errors + performance. Empty DSN = Sentry is never initialised.
# SENTRY_DSN=https://<public-key>@o<org-id>.ingest.<region>.sentry.io/<project-id>
# SENTRY_ENVIRONMENT=production     # defaults to NODE_ENV
# SENTRY_RELEASE=construction-api@<git-sha>
# SENTRY_TRACES_SAMPLE_RATE=0.1     # share of requests traced (0–1); /health* never traced
# PostHog product analytics (project API key "phc_…"). Empty = no events.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com / self-hosted
