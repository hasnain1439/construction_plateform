NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# App connections (see README "Database roles")
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/construction
DATABASE_ADMIN_URL=postgresql://app_admin:CHANGE_ME@localhost:5432/construction
# Prisma CLI only (migrations, seed): schema owner / superuser
DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME@localhost:5432/construction

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-chars
JWT_REFRESH_PEPPER=change-me-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=.example.com
SMS_PROVIDER=console
# ENABLE_DOCS=true
# TRUST_PROXY=1
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT_MAX=10
REDIS_URL=redis://localhost:6379

# File storage (local provider)
# local (default: files in STORAGE_DIR) | cloudinary
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
# Signed download links expire after this many seconds (default 600 = 10 min)
# SIGNED_URL_TTL_SECONDS=600
# Required when STORAGE_PROVIDER=cloudinary:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=CHANGE_ME
# Optional — Cloudinary token-based auth key, makes thumbnail URLs expire too:
# CLOUDINARY_AUTH_TOKEN_KEY=
# API_PUBLIC_URL=http://localhost:4000
