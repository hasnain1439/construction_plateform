# ─── PRODUCTION API settings ─────────────────────────────────────────────────
# Copy to /opt/construction/api.env on the production server (chmod 600). Passed to the api
# container as-is. Every key is documented in ../../.env.example and README → Providers.
# Set by docker-compose.prod.yml — do NOT put them here: NODE_ENV, PORT, TRUST_PROXY,
# DATABASE_URL, DATABASE_ADMIN_URL, APP_URL, API_PUBLIC_URL, CORS_ORIGINS, STORAGE_DIR.
# NEVER commit the filled-in file.

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"  (different for staging!)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_PEPPER=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
# COOKIE_DOMAIN stays unset: browsers only talk to APP_DOMAIN (the web app proxies /api/v1), so cookies are host-only.
# ENABLE_DOCS=false
LOG_LEVEL=info
DB_POOL_MAX=20
MOBILE_MIN_APP_VERSION=1.0.0
MOBILE_LATEST_APP_VERSION=1.0.0

# Production refuses console SMS / mail and local storage (README → Providers).
SMS_PROVIDER=http
SMS_SENDER_ID=CHANGE_ME
SMS_HTTP_URL=https://sms-gateway.example.pk/api/v1/send
SMS_HTTP_AUTH=bearer
SMS_HTTP_API_KEY=CHANGE_ME
# SMS_HTTP_SUCCESS_MATCH=
# SMS_HTTP_ID_PATH=

MAIL_PROVIDER=ses
MAIL_FROM=Construction Platform <no-reply@mail.example.pk>
SES_REGION=eu-west-1
SES_ACCESS_KEY_ID=CHANGE_ME
SES_SECRET_ACCESS_KEY=CHANGE_ME

WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

STORAGE_PROVIDER=s3
S3_BUCKET=CHANGE_ME
S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Observability (empty = off). SENTRY_RELEASE is baked into the image (construction-api@<git sha>).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
