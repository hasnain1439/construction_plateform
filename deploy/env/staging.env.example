# ─── STAGING stack settings ───────────────────────────────────────────────
# Copy to /opt/construction/.env on the staging server (chmod 600). Read by docker compose
# for ${…} in docker-compose.prod.yml, the Caddyfile domains and the postgres init script.
# API application settings (JWT secrets, providers, Sentry …) go in api.env — see staging.api.env.example.
# NEVER commit the filled-in file. Generate passwords with:  openssl rand -hex 32
# (hex only: they are put into postgresql:// URLs unescaped).

# Public names (DNS A/AAAA records → this server). Caddy gets HTTPS certificates for both.
APP_DOMAIN=staging.example.pk
API_DOMAIN=api.staging.example.pk
# Let's Encrypt account / expiry notices
ACME_EMAIL=ops@example.pk

# Images (GHCR). deploy.sh rewrites the two *_TAG lines on every deploy / rollback.
API_IMAGE=ghcr.io/OWNER/construction-api
WEB_IMAGE=ghcr.io/OWNER/construction-web
API_TAG=staging
WEB_TAG=staging

# Postgres. POSTGRES_* = superuser / schema owner, used only by `migrate` and backups.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_HEX
POSTGRES_DB=construction
# The API's roles (created on the first start of an empty volume by postgres/init/01-app-roles.sh)
APP_USER_PASSWORD=CHANGE_ME_HEX
APP_ADMIN_PASSWORD=CHANGE_ME_HEX

# Web server-side Sentry DSN override (optional; browser DSN is baked into the web image)
WEB_SENTRY_DSN=

# Backups (scripts/backup/pg-backup.sh, run by cron on the host)
# pg_dump / pg_restore run inside the postgres container of this compose project (versions always match)
BACKUP_COMPOSE_DIR=/opt/construction
BACKUP_DIR=/var/backups/construction
BACKUP_RETENTION_DAYS=7
# Optional: command run after each dump with the file path as $1 (e.g. rclone / aws s3 cp to off-site storage)
# BACKUP_UPLOAD_CMD='rclone copy --immutable "$1" r2:construction-backups/staging/'
