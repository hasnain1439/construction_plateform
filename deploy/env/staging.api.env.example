# ─── STAGING API settings ────────────────────────────────────────────────────
# Copy to /opt/construction/api.env on the staging server (chmod 600). Same keys as
# production.api.env.example; staging may keep the development providers.
# Set by docker-compose.prod.yml — do NOT put them here: NODE_ENV, PORT, TRUST_PROXY,
# DATABASE_URL, DATABASE_ADMIN_URL, APP_URL, API_PUBLIC_URL, CORS_ORIGINS, STORAGE_DIR.
# NEVER commit the filled-in file. Use DIFFERENT secrets from production.

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_PEPPER=CHANGE_ME
OTP_TTL_SECONDS=300
# COOKIE_DOMAIN stays unset: browsers only talk to APP_DOMAIN (the web app proxies /api/v1), so cookies are host-only.
ENABLE_DOCS=true
LOG_LEVEL=debug

# Console SMS / mail print to `docker compose logs api`; files on the api_storage volume.
# Switch to the real providers (see production.api.env.example) to rehearse a launch.
ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true
SMS_PROVIDER=console
MAIL_PROVIDER=console
WHATSAPP_ENABLED=false
STORAGE_PROVIDER=local

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1
POSTHOG_KEY=
