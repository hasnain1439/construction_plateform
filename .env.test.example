NODE_ENV=test
PORT=4001
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app_user:app_user_dev_pw@localhost:5432/construction_test
DATABASE_ADMIN_URL=postgresql://app_admin:app_admin_dev_pw@localhost:5432/construction_test
# construction_test is the template: each test worker gets a copy, construction_w<n>_test (README → Tests).
# The migration URL must be a superuser (creates the copies; resets use session_replication_role).
DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME@localhost:5432/construction_test
JWT_ACCESS_SECRET=test-access-secret-test-access-secret-0123456789
JWT_REFRESH_PEPPER=test-refresh-pepper-test-refresh-pepper-0123456789
CORS_ORIGINS=http://localhost:3000
SMS_PROVIDER=console
BCRYPT_ROUNDS=4
AUTH_RATE_LIMIT_MAX=1000
AUTH_IP_RATE_LIMIT_MAX=100000
OTP_SEND_IP_RATE_LIMIT_MAX=100000
SYNC_PUSH_RATE_LIMIT_MAX=100000
# STORAGE_DIR is set by vitest.config.ts (OS temp folder, one sub-folder per worker, removed after the run)
# Tests never touch Cloudinary (the provider is tested with a mocked SDK)
STORAGE_PROVIDER=local

# Tests never send real email, SMS or WhatsApp (SES / HTTP gateway / Cloud API / S3 are mocked in tests/providers).
MAIL_PROVIDER=console
WHATSAPP_ENABLED=false

# Parallel run (optional; the shell wins over this file). Workers default to half the CPU threads.
# TEST_MAX_WORKERS=4
# TEST_DB_POOL_MAX=5
# TEST_SERIAL=1   # same as npm run test:serial
